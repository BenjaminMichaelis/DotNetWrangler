<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddAnalyzersToPackage</TargetsForTfmSpecificContentInPackage>

    <PackageId>DotNetWrangler.Analyzers</PackageId>
    <Version>0.0.0-dev</Version>
    <Authors>Benjamin Michaelis</Authors>
    <Description>Roslyn analyzers that put guardrails on .NET code: explicit null contracts, meaningful test failures, and reviewable warning suppressions.</Description>
    <PackageTags>roslyn;analyzers;nullable;null-forgiving;pragma;code-quality</PackageTags>
    <PackageProjectUrl>https://benjaminmichaelis.github.io/DotNetWrangler/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BenjaminMichaelis/DotNetWrangler</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wrangler.Analyzers\Wrangler.Analyzers.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Wrangler.CodeFixes\Wrangler.CodeFixes.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="AddAnalyzersToPackage">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)Wrangler.Analyzers.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)Wrangler.CodeFixes.dll" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
